# ==========================================
# 기본 텍스트 파일 처리
# ==========================================

# 파일 형식을 자동으로 감지하여 텍스트 파일로 처리
* text=auto

# 일반 텍스트 파일은 LF 줄바꿈 사용
*.md           text eol=lf
*.java         text eol=lf
*.dart         text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.gradle       text eol=lf
*.gradle.kts   text eol=lf
*.properties   text eol=lf
*.sql          text eol=lf
*.sh           text eol=lf

# Windows 배치 파일은 CRLF 줄바꿈 사용
*.bat          text eol=crlf
*.cmd          text eol=crlf

# ==========================================
# 바이너리 파일 처리
# ==========================================

# 이미지 파일
*.png          binary
*.jpg          binary
*.jpeg         binary
*.webp         binary
*.gif          binary
*.ico          binary

# 문서 파일
*.pdf          binary